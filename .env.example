# Clave de la API de Anthropic (requerida). Se usa en app/api/review para
# calificar el documento contra la rúbrica Centinela v3.
ANTHROPIC_API_KEY=

# Contraseña única del equipo para esta fase del MVP (sin usuarios
# individuales todavía). Se usa en /login y /api/login.
CENTINELA_PASSWORD=

# Secreto para firmar la cookie de sesión. Opcional: si se omite, se deriva
# de CENTINELA_PASSWORD. Se recomienda definirlo aparte en producción.
CENTINELA_AUTH_SECRET=

# Opcional: modelo de Claude a usar para el análisis. Por defecto claude-opus-5-5.
CENTINELA_MODEL=

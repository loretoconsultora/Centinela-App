# Clave de la API de Anthropic (requerida). Se usa en app/api/review para
# calificar el documento contra la rúbrica Centinela v3.
ANTHROPIC_API_KEY=

# Supabase (requeridas). La URL y la clave publishable son públicas por diseño;
# la clave secreta se salta las reglas de seguridad: solo en Vercel, NUNCA con
# el prefijo NEXT_PUBLIC_ ni en el repo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Opcional: la contraseña inicial compartida del equipo. Si se define, el
# cambio obligatorio de contraseña rechaza que la nueva sea igual a esta.
CENTINELA_PASSWORD_INICIAL=

# Opcional: modelo de Claude a usar para el análisis. Por defecto claude-opus-5-5.
CENTINELA_MODEL=
